<%- include('partials/header', { title: appel.titre, page: 'appels-offres' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/appels-offres">Appels d'offres SEAO</a></li>
    <li class="breadcrumb-item active"><%= appel.numero_seao %></li>
  </ol>
</nav>

<div class="row">
  <div class="col-md-8">
    <div class="card mb-3">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><%= appel.titre %></h5>
        <% if (joursRestants !== null) { %>
          <span class="badge <%= joursRestants < 3 ? 'bg-danger' : (joursRestants < 7 ? 'bg-warning text-dark' : 'bg-light text-dark') %>">
            <%= joursRestants >= 0 ? joursRestants + ' jour(s) restant(s)' : 'Délai dépassé' %>
          </span>
        <% } %>
      </div>
      <div class="card-body">
        <table class="table table-sm">
          <tr><th style="width:220px">Numéro SEAO</th><td><%= appel.numero_seao %></td></tr>
          <tr><th>Donneur d'ouvrage</th><td><%= appel.donneur_ouvrage || '-' %></td></tr>
          <tr><th>Lieu des travaux</th><td><%= appel.lieu_travaux || '-' %></td></tr>
          <tr><th>Date de publication</th><td><%= (appel.date_publication || '-').replace('T',' ').substring(0,16) %></td></tr>
          <tr><th>Date et heure de fermeture</th><td><strong><%= (appel.date_fermeture || '-').replace('T',' ').substring(0,16) %></strong></td></tr>
          <tr><th>Visite obligatoire</th><td><%= appel.date_visite_obligatoire || 'Non précisée dans les données SEAO' %></td></tr>
          <tr><th>Type de projet</th><td><%= appel.type_projet || '-' %></td></tr>
          <tr><th>Mots-clés détectés</th><td>
            <% (appel.mots_cles_matches || '').split(',').filter(Boolean).forEach(function(m) { %>
            <span class="badge bg-secondary bg-opacity-75"><%= m.trim() %></span>
            <% }) %>
          </td></tr>
          <% if (appel.url_seao) { %>
          <tr><th>Avis complet sur SEAO</th><td><a href="<%= appel.url_seao %>" target="_blank" rel="noopener"><%= appel.url_seao %> <i class="bi bi-box-arrow-up-right"></i></a></td></tr>
          <% } %>
        </table>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header bg-light"><i class="bi bi-paperclip"></i> Documents disponibles</div>
      <div class="card-body">
        <% if (documents.length === 0) { %>
        <p class="text-muted small mb-0">Aucun document (devis, plans, addenda, formulaire) importé pour cet appel d'offres pour l'instant.</p>
        <% } else { %>
        <ul class="list-group mb-3">
          <% documents.forEach(function(d) { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><span class="badge bg-secondary me-2"><%= d.categorie %></span><%= d.nom_fichier %></span>
            <div class="d-flex align-items-center gap-2">
              <% if (d.categorie === 'addenda') { %>
              <form method="POST" action="/appels-offres/<%= appel.id %>/documents/<%= d.id %>/accuser" class="d-inline">
                <button type="submit" class="btn btn-sm <%= d.accuse ? 'btn-success' : 'btn-outline-secondary' %>" title="Accusé de réception">
                  <i class="bi <%= d.accuse ? 'bi-check-circle-fill' : 'bi-circle' %>"></i> <%= d.accuse ? 'Accusé reçu' : 'Accuser réception' %>
                </button>
              </form>
              <% } %>
              <form method="POST" action="/appels-offres/<%= appel.id %>/documents/<%= d.id %>/supprimer" onsubmit="return confirm('Supprimer ce document ?');" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </div>
          </li>
          <% }) %>
        </ul>
        <% } %>

        <hr>
        <p class="text-muted small mb-2"><i class="bi bi-plus-circle"></i> Ajouter un document :</p>
        <form id="formAjoutDoc">
          <div class="row g-2">
            <div class="col-md-5">
              <select id="categorieDoc" class="form-select form-select-sm">
                <option value="devis">Devis</option>
                <option value="plans">Plans</option>
                <option value="addenda">Addenda</option>
                <option value="formulaire_soumission">Formulaire de soumission</option>
                <option value="documents_administratifs">Documents administratifs</option>
              </select>
            </div>
            <div class="col-md-5">
              <input type="file" id="fichierDoc" class="form-control form-control-sm" accept=".pdf,.docx,.doc">
            </div>
            <div class="col-md-2">
              <button type="submit" id="btnAjoutDoc" class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-upload"></i> Ajouter</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="card mb-3" id="exigences">
      <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <span><i class="bi bi-ul"></i> Résumé de l'appel d'offres — exigences</span>
        <form method="POST" action="/appels-offres/<%= appel.id %>/exigences/analyser" class="d-inline">
          <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-magic"></i> <%= exigences.length ? 'Réanalyser' : 'Analyser avec l\'IA' %></button>
        </form>
      </div>
      <div class="card-body">
        <% if (exigences.length === 0) { %>
        <p class="text-muted small mb-0">Aucune exigence extraite pour l'instant. Importez les documents (devis, formulaire de soumission, addendas...) puis lancez l'analyse.</p>
        <% } else { %>
        <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead><tr><th>Élément</th><th>Réponse</th><th>Statut</th><th>Confiance</th><th>Source</th><th></th></tr></thead>
          <tbody>
          <% exigences.forEach(function(e) { %>
          <tr class="<%= e.valide_manuellement ? 'table-light' : '' %>">
            <td>
              <%= e.titre %>
              <% if (!e.obligatoire) { %><span class="badge bg-secondary bg-opacity-50">facultatif</span><% } %>
              <% if (e.valide_manuellement) { %><span class="badge bg-success bg-opacity-75" title="Corrigé manuellement"><i class="bi bi-pencil-fill"></i></span><% } %>
            </td>
            <td style="max-width:260px"><%= e.valide_manuellement && e.valeur_corrigee ? e.valeur_corrigee : (e.valeur || '—') %></td>
            <td>
              <% var badgeStatut = { confirme: 'bg-success', a_verifier: 'bg-warning text-dark', contradictoire: 'bg-danger', non_trouve: 'bg-secondary' }[e.statut] || 'bg-secondary'; %>
              <span class="badge <%= badgeStatut %>"><%= (e.statut || '').replace('_', ' ') %></span>
            </td>
            <td>
              <% var badgeConf = { eleve: 'bg-success', moyen: 'bg-warning text-dark', faible: 'bg-danger' }[e.niveau_confiance] || 'bg-secondary'; %>
              <span class="badge <%= badgeConf %> bg-opacity-75"><%= e.niveau_confiance %></span>
            </td>
            <td class="small text-muted">
              <% if (e.document_source) { %>
              <button class="btn btn-sm btn-link p-0" type="button" data-bs-toggle="collapse" data-bs-target="#source-<%= e.id %>">
                <i class="bi bi-search"></i> Voir la source
              </button>
              <div class="collapse mt-1" id="source-<%= e.id %>">
                <div class="border rounded p-2 bg-light">
                  <strong><%= e.document_source %></strong><% if (e.numero_page) { %>, page <%= e.numero_page %><% } %>
                  <div class="fst-italic">« <%= e.extrait_source %> »</div>
                </div>
              </div>
              <% } else { %>—<% } %>
            </td>
            <td>
              <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#corriger-<%= e.id %>"><i class="bi bi-pencil"></i></button>
              <div class="collapse" id="corriger-<%= e.id %>">
                <form method="POST" action="/appels-offres/<%= appel.id %>/exigences/<%= e.id %>/corriger" class="mt-2 p-2 border rounded">
                  <div class="mb-2">
                    <label class="form-label small mb-0">Valeur corrigée</label>
                    <input type="text" name="valeur_corrigee" class="form-control form-control-sm" value="<%= e.valeur_corrigee || '' %>">
                  </div>
                  <div class="row g-1 mb-2">
                    <div class="col-6">
                      <label class="form-label small mb-0">Responsable</label>
                      <input type="text" name="responsable" class="form-control form-control-sm" value="<%= e.responsable || '' %>">
                    </div>
                    <div class="col-6">
                      <label class="form-label small mb-0">Échéance</label>
                      <input type="date" name="date_echeance" class="form-control form-control-sm" value="<%= (e.date_echeance || '').substring(0,10) %>">
                    </div>
                  </div>
                  <button type="submit" class="btn btn-sm btn-success w-100">Enregistrer la correction</button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
          </tbody>
        </table>
        </div>
        <% if (exigences.some(function(e) { return e.statut === 'non_trouve' || e.niveau_confiance === 'faible'; })) { %>
        <p class="text-warning small mb-0"><i class="bi bi-exclamation-triangle"></i> Certaines informations n'ont pas été confirmées — vérifiez-les manuellement avant le dépôt.</p>
        <% } %>
        <% } %>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header bg-light"><i class="bi bi-file-earmark-text"></i> Formulaire de soumission</div>
      <div class="card-body">
        <% if (formulaires.length === 0) { %>
        <p class="text-muted small">
          Aucun formulaire déposé pour cet appel d'offres. Les données ouvertes du SEAO ne fournissent que les métadonnées de l'avis (titre, dates, donneur d'ouvrage) — pas les documents eux-mêmes.
          <% if (appel.url_seao) { %>Téléchargez le formulaire de soumission depuis <a href="<%= appel.url_seao %>" target="_blank" rel="noopener">l'avis SEAO complet <i class="bi bi-box-arrow-up-right"></i></a>, puis déposez-le ci-dessous.<% } else { %>Téléchargez-le depuis le site du SEAO, puis déposez-le ci-dessous.<% } %>
        </p>
        <% } else { %>
        <% formulaires.forEach(function(f) { %>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span>
            <span class="badge bg-info text-dark me-2"><%= f.format || '?' %></span>
            Statut :
            <span class="badge <%= f.statut === 'valide' ? 'bg-success' : (f.statut === 'pre_rempli' ? 'bg-warning text-dark' : 'bg-secondary') %>">
              <%= f.statut === 'valide' ? 'Validé' : (f.statut === 'pre_rempli' ? 'Brouillon' : 'À remplir') %>
            </span>
          </span>
          <a href="/appels-offres/<%= appel.id %>/formulaire/<%= f.id %>" class="btn btn-sm btn-primary"><i class="bi bi-magic"></i> Ouvrir / Remplir</a>
        </div>
        <% }) %>
        <% } %>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header bg-light"><i class="bi bi-clock-history"></i> Historique</div>
      <div class="card-body">
        <% if (historique.length === 0) { %>
        <p class="text-muted small mb-0">Aucune action enregistrée pour l'instant.</p>
        <% } else { %>
        <ul class="list-group list-group-flush">
          <% historique.forEach(function(h) { %>
          <li class="list-group-item small">
            <strong><%= h.action.replace(/_/g, ' ') %></strong>
            <% if (h.effectue_par) { %> — <%= h.effectue_par %><% } %>
            <span class="text-muted">— <%= h.created_at %></span>
            <% if (h.details) { %><div class="text-muted fst-italic"><%= h.details %></div><% } %>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card mb-3 <%= pretADeposer ? 'border-success' : 'border-warning' %>">
      <div class="card-header <%= pretADeposer ? 'bg-success bg-opacity-25' : 'bg-warning bg-opacity-25' %>">
        <i class="bi bi-list-check"></i> Checklist de dépôt
      </div>
      <div class="card-body">
        <% if (pretADeposer) { %>
        <p class="text-success fw-bold small mb-2"><i class="bi bi-check-circle"></i> Prêt à déposer</p>
        <% } %>
        <ul class="list-unstyled mb-0">
          <% checklist.forEach(function(c) { %>
          <li class="mb-1">
            <% if (c.ok) { %>
              <i class="bi bi-check-circle-fill text-success"></i>
            <% } else if (c.obligatoire) { %>
              <i class="bi bi-x-circle-fill text-danger"></i>
            <% } else { %>
              <i class="bi bi-dash-circle text-muted"></i>
            <% } %>
            <%= c.label %>
          </li>
          <% }) %>
        </ul>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-light"><i class="bi bi-flag"></i> Statut interne</div>
      <div class="card-body">
        <form method="POST" action="/appels-offres/<%= appel.id %>/statut">
          <select name="statut" class="form-select mb-2" onchange="this.form.submit()">
            <% statuts.forEach(function(s) { %>
            <option value="<%= s %>" <%= appel.statut_interne === s ? 'selected' : '' %>><%= labelsStatut[s] %></option>
            <% }) %>
          </select>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="/js/direct-upload.js"></script>
<script>
window.T3E_SUPABASE_URL = "<%= SUPABASE_URL %>";
window.T3E_SUPABASE_ANON_KEY = "<%= SUPABASE_ANON_KEY %>";

document.getElementById('formAjoutDoc').addEventListener('submit', function (e) {
  e.preventDefault();
  var fichier = document.getElementById('fichierDoc').files[0];
  if (!fichier) return;
  var categorie = document.getElementById('categorieDoc').value;
  var btn = document.getElementById('btnAjoutDoc');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

  t3eDirectUpload.uploadDirect(fichier, 'temp').then(function (info) {
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/appels-offres/<%= appel.id %>/documents';
    [['categorie', categorie], ['fichier_key', info.key], ['fichier_name', info.name]].forEach(function (pair) {
      var inp = document.createElement('input');
      inp.type = 'hidden'; inp.name = pair[0]; inp.value = pair[1];
      form.appendChild(inp);
    });
    document.body.appendChild(form);
    form.submit();
  }).catch(function (err) {
    alert("Erreur lors de l'envoi du fichier : " + err.message);
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-upload"></i> Ajouter';
  });
});
</script>

<%- include('partials/footer', { scripts: [] }) %>
