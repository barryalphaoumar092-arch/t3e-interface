<%
var lignesExclues = f.lignes_ignorees ? JSON.parse(f.lignes_ignorees) : [];
var codesAConfirmer = f.codes_a_confirmer ? JSON.parse(f.codes_a_confirmer) : [];
var infosLignes = f.lignes_corrigees ? JSON.parse(f.lignes_corrigees) : null;
%>
<%- include('partials/header', { title: 'Feuille de temps', page: 'heures' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/heures">Heures</a></li><li class="breadcrumb-item active">Semaine <%= f.semaine_debut %> au <%= f.semaine_fin %></li></ol>
</nav>

<div class="d-flex justify-content-between align-items-start">
  <div>
    <h2>Semaine <%= f.semaine_debut %> au <%= f.semaine_fin %></h2>
    <p><span class="badge bg-secondary">Étape <%= f.etape %></span> <span class="badge bg-info-subtle text-dark"><%= f.statut %></span></p>
  </div>
  <form method="POST" action="/heures/<%= f.id %>/supprimer" onsubmit="return confirm('Supprimer cette semaine de la plateforme ?')">
    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Supprimer</button>
  </form>
</div>

<% if (f.statut === 'en_cours') { %>
<div class="alert alert-info"><span class="spinner-border spinner-border-sm me-2"></span>Correction en cours…</div>
<script>setTimeout(function () { location.reload(); }, 6000);</script>
<% } else if (f.statut === 'erreur') { %>
<%
// etape n'est bumpe qu'APRES un succes — donc une erreur a etape===1 peut
// venir soit de l'etape 1 elle-meme (correction), soit de l'etape 2
// (ecriture Feuille Maitre, qui echoue avant de bumper etape) : on les
// distingue via lignes_corrigees (rempli seulement si l'etape 1 a reussi).
var echecEtape1Correction = f.etape === 1 && !f.lignes_corrigees;
var echecEtape2 = f.etape === 1 && !!f.lignes_corrigees;
var echecEtape3 = f.etape === 2;
var estDoublon = /existe(nt)? déjà/.test(f.generation_erreur || '');
%>
<div class="alert alert-danger"><i class="bi bi-exclamation-octagon"></i> <%= f.generation_erreur %></div>

<% if (echecEtape1Correction) { %>
<form method="POST" action="/heures/<%= f.id %>/relancer">
  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-arrow-clockwise"></i> Réessayer</button>
</form>
<% } %>

<% if (echecEtape2) { %>
<a href="/heures/<%= f.id %>/telecharger-maitre" class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-download"></i> Voir la Feuille Maître actuelle</a>
<form method="POST" action="/heures/<%= f.id %>/relancer-etape2" class="d-inline">
  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-arrow-clockwise"></i> Réessayer</button>
</form>
<% if (estDoublon) { %>
<form method="POST" action="/heures/<%= f.id %>/relancer-etape2" class="d-inline ms-2" onsubmit="return confirm('Confirmez-vous que cette semaine est déjà présente intentionnellement (ex. données de test) et que la plateforme peut continuer sans la réécrire ?')">
  <input type="hidden" name="confirmer" value="1">
  <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-check2"></i> C'est normal, continuer quand même</button>
</form>
<% } %>
<% } %>

<% if (echecEtape3) { %>
<a href="/heures/<%= f.id %>/telecharger-suivi" class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-download"></i> Voir le Suivi des heures actuel</a>
<form method="POST" action="/heures/<%= f.id %>/relancer-etape3" class="d-inline">
  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-arrow-clockwise"></i> Réessayer</button>
</form>
<% if (estDoublon) { %>
<form method="POST" action="/heures/<%= f.id %>/relancer-etape3" class="d-inline ms-2" onsubmit="return confirm('Confirmez-vous que cette semaine est déjà présente intentionnellement (ex. données de test) dans ABCD-COPIE.xlsx et que la plateforme peut passer à la révision sans réécrire ?')">
  <input type="hidden" name="confirmer" value="1">
  <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-check2"></i> C'est normal, continuer quand même</button>
</form>
<% } %>
<% } %>
<% } %>

<% if (f.statut === 'a_valider') { %>
<div class="card card-body mb-3">
  <h5><i class="bi bi-clipboard-check"></i> Révision de l'étape 1</h5>
  <% if (infosLignes) { %><p><%= infosLignes.nbLignes %> ligne(s) conservée(s).</p><% } %>

  <% if (codesAConfirmer.length > 0) { %>
  <div class="alert alert-warning">
    <strong>Codes projet non standards à confirmer</strong> (ni exclus automatiquement, ni reconnus) :
    <ul class="mb-0"><% codesAConfirmer.forEach(function (c) { %><li><%= c %></li><% }) %></ul>
  </div>
  <% } %>

  <% if (lignesExclues.length > 0) { %>
  <details class="mb-2"><summary><%= lignesExclues.length %> ligne(s) exclue(s) automatiquement (R-/I-/SHOP)</summary>
    <ul><% lignesExclues.slice(0, 50).forEach(function (l) { %><li><%= l.code %></li><% }) %></ul>
  </details>
  <% } %>

  <a href="/heures/<%= f.id %>/telecharger" class="btn btn-success mb-3"><i class="bi bi-download"></i> Télécharger le fichier corrigé</a>

  <form method="POST" action="/heures/<%= f.id %>/valider-etape1" id="formValider">
    <p class="text-muted small">Si vous avez modifié le fichier téléchargé, re-déposez-le ci-dessous avant de valider — sinon validez directement.</p>
    <input type="file" id="inputRevise" class="form-control mb-2" accept=".xlsx">
    <input type="hidden" name="fichier_key" id="ficheirKeyRevise">
    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Valider l'étape 1</button>
  </form>
</div>
<% } %>

<% if (f.statut === 'valide_etape1') { %>
<div class="alert alert-info"><span class="spinner-border spinner-border-sm me-2"></span>Ajout dans la Feuille Maître en cours…</div>
<script>setTimeout(function () { location.reload(); }, 5000);</script>
<% } %>

<% if (f.statut === 'ajoute_maitre') { %>
<div class="card card-body mb-3">
  <h5><i class="bi bi-journal-check"></i> Révision de l'étape 2 — Feuille Maître mise à jour</h5>
  <p>Les lignes de cette semaine ont été ajoutées à <code>Feuilles Maître heures - 2026.xlsx</code> (par ordre chronologique).</p>
  <a href="/heures/<%= f.id %>/telecharger-maitre" class="btn btn-success mb-3"><i class="bi bi-download"></i> Télécharger la Feuille Maître</a>
  <form method="POST" action="/heures/<%= f.id %>/valider-etape2">
    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Confirmer l'étape 2</button>
  </form>
</div>
<% } %>

<% if (f.statut === 'valide_etape2') { %>
<div class="alert alert-info"><span class="spinner-border spinner-border-sm me-2"></span>Ajout dans le Suivi des heures en cours…</div>
<script>setTimeout(function () { location.reload(); }, 5000);</script>
<% } %>

<% if (f.statut === 'ajoute_suivi') { %>
<div class="card card-body mb-3">
  <h5><i class="bi bi-bar-chart-steps"></i> Révision de l'étape 3 — Suivi des heures (ABCD-COPIE.xlsx)</h5>
  <% if (f.generation_erreur) { %><div class="alert alert-warning small"><%= f.generation_erreur %></div><% } %>
  <a href="/heures/<%= f.id %>/telecharger-suivi" class="btn btn-success mb-3"><i class="bi bi-download"></i> Télécharger le Suivi des heures</a>
  <form method="POST" action="/heures/<%= f.id %>/valider-etape3">
    <p class="mb-1"><strong>Envoyer le document final à :</strong></p>
    <% Object.keys(DESTINATAIRES_FINAL_POSSIBLES).forEach(function (cle) { %>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="destinataires" value="<%= cle %>" id="dest-<%= cle %>">
      <label class="form-check-label" for="dest-<%= cle %>"><%= DESTINATAIRES_FINAL_POSSIBLES[cle].nom %> (<%= DESTINATAIRES_FINAL_POSSIBLES[cle].email %>)</label>
    </div>
    <% }) %>
    <button type="submit" class="btn btn-primary mt-2"><i class="bi bi-check2-circle"></i> Confirmer et envoyer le document final</button>
  </form>
</div>
<% } %>

<% if (f.statut === 'termine') { %>
<% if (f.generation_erreur) { %>
<div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> <%= f.generation_erreur %></div>
<a href="/heures/<%= f.id %>/telecharger-suivi" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> Télécharger le Suivi des heures pour l'envoyer manuellement</a>
<% } else { %>
<div class="alert alert-success"><i class="bi bi-check2-all"></i> Terminé — le document final a été envoyé. Rien à faire tant qu'une nouvelle feuille de temps n'est pas déposée.</div>
<% } %>
<% } %>

<script src="https://unpkg.com/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="/js/direct-upload.js"></script>
<script>
window.T3E_SUPABASE_URL = "<%= SUPABASE_URL %>";
window.T3E_SUPABASE_ANON_KEY = "<%= SUPABASE_ANON_KEY %>";
var inputRevise = document.getElementById('inputRevise');
if (inputRevise) {
  document.getElementById('formValider').addEventListener('submit', async function (e) {
    if (!inputRevise.files[0]) return; // pas de re-upload, valider tel quel
    e.preventDefault();
    var info = await window.t3eDirectUpload.uploadDirect(inputRevise.files[0], 'temp');
    document.getElementById('ficheirKeyRevise').value = info.key;
    e.target.submit();
  });
}
</script>

<%- include('partials/footer', { scripts: [] }) %>
