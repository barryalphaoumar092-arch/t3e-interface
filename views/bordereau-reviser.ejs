<%- include('partials/header', { title: 'Réviser les bordereaux', page: 'bordereaux' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/bordereaux">Bordereaux</a></li>
    <li class="breadcrumb-item active">Réviser</li>
  </ol>
</nav>

<div class="row justify-content-center">
  <div class="col-md-11">

    <div class="d-flex gap-2 mb-3 align-items-center">
      <span class="badge bg-success fs-6"><i class="bi bi-check"></i> 1. Upload</span>
      <span class="badge bg-primary fs-6">2. Révision</span>
      <span class="badge bg-secondary fs-6">3. Téléchargement</span>
      <span class="badge fs-6 <%= bordereau.statut === 'approuve' ? 'bg-success' : (bordereau.statut === 'revise' ? 'bg-warning text-dark' : 'bg-secondary') %>">
        Statut : <%= bordereau.statut === 'approuve' ? 'Approuvé' : (bordereau.statut === 'revise' ? 'En révision' : 'Brouillon') %>
        <% if (bordereau.statut === 'approuve' && bordereau.approuve_par) { %> — par <%= bordereau.approuve_par %><% } %>
      </span>
    </div>

    <% if (bordereau.statut === 'revise') { %>
    <div class="card border-warning mb-3">
      <div class="card-header bg-warning bg-opacity-25 py-2">
        <h6 class="mb-0"><i class="bi bi-question-circle"></i> Vérification avant approbation</h6>
      </div>
      <div class="card-body">
        <p class="mb-3">Ce bordereau a été généré (le ZIP a été téléchargé). <strong>Des modifications sont-elles nécessaires ?</strong></p>
        <form method="POST" action="/bordereaux/confirmer/<%= bordereau.id %>" id="formConfirmer" class="row g-2 align-items-start">
          <div class="col-md-4">
            <label class="form-label small">Votre nom</label>
            <input type="text" name="confirme_par" class="form-control form-control-sm" placeholder="Qui confirme ?">
          </div>
          <div class="col-md-8">
            <label class="form-label small">Commentaire <span class="text-muted">(obligatoire si des modifications sont nécessaires)</span></label>
            <input type="text" name="commentaire" id="commentaireConfirmer" class="form-control form-control-sm" placeholder="Ex : mauvais fabricant pour le produit 2">
          </div>
          <div class="col-12 d-flex gap-2 mt-2">
            <button type="submit" name="reponse" value="oui" class="btn btn-outline-danger" id="btnOuiModif">
              <i class="bi bi-pencil"></i> Oui, des modifications sont nécessaires
            </button>
            <button type="submit" name="reponse" value="non" class="btn btn-success">
              <i class="bi bi-check-circle"></i> Non, approuver tel quel
            </button>
          </div>
        </form>
      </div>
    </div>
    <p class="text-muted small mb-3"><i class="bi bi-info-circle"></i> Vous pouvez aussi modifier directement les champs ci-dessous et régénérer, mais répondre à la question ci-dessus garantit un historique fiable (qui a demandé quoi, et pourquoi).</p>
    <% } %>

    <% if (iaErreur) { %>
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> L'IA n'a pas pu analyser le devis (<%= iaErreur %>). Remplissez les champs manuellement.</div>
    <% } else { %>
    <div class="alert alert-info mb-3">
      <i class="bi bi-robot"></i> L'IA a détecté <strong><%= produits.length %></strong> produit<%= produits.length > 1 ? 's' : '' %>.
      Vérifiez et corrigez si nécessaire, puis cliquez sur <strong>Générer</strong>.
    </div>
    <% } %>

    <form method="POST" action="/bordereaux/generer/<%= bordereau.id %>" id="formGenerer">

      <!-- Identification commune -->
      <div class="card mb-3">
        <div class="card-header bg-dark text-white py-2">
          <h6 class="mb-0"><i class="bi bi-building"></i> Projet & Identification</h6>
        </div>
        <div class="card-body">
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label fw-bold">NOM DU PROJET</label>
              <input type="text" name="NOM_DU_PROJET" class="form-control" value="<%= nomProjet %>">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-bold">NUMÉRO DU PROJET</label>
              <input type="text" name="NUMERO_DU_PROJET" class="form-control" value="<%= numProjet %>">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-bold">SPÉCIALITÉ</label>
              <input type="text" name="SPECIALITE" class="form-control" value="<%= identification.SPECIALITE || 'COUVREUR' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">NOM</label>
              <input type="text" name="NOM" class="form-control" value="<%= identification.NOM || 'Toitures Trois Étoiles' %>">
            </div>
            <div class="col-md-8">
              <label class="form-label fw-bold">ADRESSE</label>
              <input type="text" name="ADRESSE" class="form-control" value="<%= identification.ADRESSE || '7550 Rue Saint-Patrick, Montréal, QC H8N 1V1' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">NOM DE L'ÉTABLISSEMENT <small class="text-muted fw-normal">(si présent sur certains gabarits d'architectes)</small></label>
              <input type="text" name="NOM_ETABLISSEMENT" class="form-control" value="<%= identification.NOM_ETABLISSEMENT || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">ARCHITECTE <small class="text-muted fw-normal">(firme / contact — si présent sur certains gabarits)</small></label>
              <input type="text" name="ARCHITECTE" class="form-control" value="<%= identification.ARCHITECTE || '' %>">
            </div>
          </div>
        </div>
      </div>

      <!-- Produits (1 carte par produit) -->
      <div id="produitsContainer">
        <% produits.forEach(function(p, idx) { %>
        <div class="card mb-3 border-primary produit-card">
          <div class="card-header bg-primary bg-opacity-10 py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
              <i class="bi bi-box-seam"></i> Produit <%= idx + 1 %>
              <% if (p.TITRE) { %><span class="text-muted ms-2">— <%= p.TITRE %></span><% } %>
            </h6>
            <button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('.produit-card').remove(); renum();" title="Supprimer">
              <i class="bi bi-trash"></i>
            </button>
          </div>
          <div class="card-body py-2">
            <div class="row g-2">
              <div class="col-md-12">
                <label class="form-label fw-bold">Titre (produit)</label>
                <input type="text" name="TITRE" class="form-control form-control-sm" value="<%= p.TITRE || '' %>">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold">Fabricant</label>
                <select class="form-select form-select-sm mb-1" onchange="this.nextElementSibling.value = this.value;">
                  <option value="">— Choisir dans la liste —</option>
                  <% fabricantsListe.forEach(function(f) { %>
                  <option value="<%= f %>" <%= p.FABRICANT === f ? 'selected' : '' %>><%= f %></option>
                  <% }); %>
                </select>
                <input type="text" name="FABRICANT" class="form-control form-control-sm fabricant-input" value="<%= p.FABRICANT || '' %>" placeholder="ou saisir manuellement">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold">Fournisseur</label>
                <select class="form-select form-select-sm mb-1" onchange="this.nextElementSibling.value = this.value;">
                  <option value="">— Choisir dans la liste —</option>
                  <% fournisseursListe.forEach(function(f) { %>
                  <option value="<%= f %>" <%= p.FOURNISSEUR === f ? 'selected' : '' %>><%= f %></option>
                  <% }); %>
                </select>
                <input type="text" name="FOURNISSEUR" class="form-control form-control-sm" value="<%= p.FOURNISSEUR || '' %>" placeholder="ou saisir manuellement">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold">Fiche technique</label>
                <select name="FT_FICHIER" class="form-select form-select-sm ft-select">
                  <option value="__AUTO__" <%= p.ft_selection === '__AUTO__' ? 'selected' : '' %>>Auto (recommandé)</option>
                  <option value="__NONE__" <%= p.ft_selection === '__NONE__' ? 'selected' : '' %>>Aucune fiche technique</option>
                  <% if (p.ft_projet_key) { %>
                  <option value="__PROJET__:<%= p.ft_projet_key %>" <%= p.ft_selection === ('__PROJET__:' + p.ft_projet_key) ? 'selected' : '' %>>Importée pour ce projet (<%= p.ft_projet_nom || 'fichier' %>)</option>
                  <% } %>
                  <% Object.keys(ftParFabricant).sort(function(a, b) { return a.localeCompare(b); }).forEach(function(fab) { %>
                  <optgroup label="<%= fab %>">
                    <% ftParFabricant[fab].forEach(function(f) { %>
                    <option value="<%= fab %>/<%= f %>" <%= p.ft_selection === (fab + '/' + f) ? 'selected' : '' %>><%= f %></option>
                    <% }); %>
                  </optgroup>
                  <% }); %>
                </select>
                <% if (p.ft_noms && p.ft_noms.length > 0) { %>
                <div class="text-success small mt-1"><i class="bi bi-check-circle"></i> Détectée : <%= p.ft_noms[0] %></div>
                <% } else { %>
                <div class="text-muted small mt-1"><i class="bi bi-dash-circle"></i> Aucune FT auto-détectée</div>
                <% } %>
              </div>

              <div class="col-md-12">
                <div class="d-flex gap-2 flex-wrap align-items-center small border rounded px-2 py-1 bg-light">
                  <span class="text-muted"><i class="bi bi-diagram-3"></i> Traçabilité :</span>
                  <% if (p.detecte_devis === true) { %>
                    <span class="badge bg-success">Détecté dans le devis</span>
                  <% } else if (p.detecte_devis === false) { %>
                    <span class="badge bg-secondary">Non détecté dans le devis</span>
                  <% } %>
                  <% if (p.ft_noms && p.ft_noms.length > 0) { %>
                    <span class="badge bg-success">Trouvée dans la bibliothèque T3E</span>
                  <% } else { %>
                    <span class="badge bg-danger">Absente de la bibliothèque T3E</span>
                  <% } %>
                  <% if (p.ft_projet_key) { %>
                    <span class="badge bg-info text-dark">Fiche jointe au projet (<%= p.ft_projet_nom %>)</span>
                  <% } else if (!(p.ft_noms && p.ft_noms.length > 0)) { %>
                    <button type="button" class="btn btn-outline-primary btn-sm ms-1 btn-importer-ft" data-idx="<%= idx %>">
                      <i class="bi bi-upload"></i> Importer une fiche pour ce produit
                    </button>
                  <% } %>
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label">Section</label>
                <input type="text" name="SECTION" class="form-control form-control-sm" value="<%= p.SECTION || '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label">Article</label>
                <input type="text" name="ARTICLE" class="form-control form-control-sm" value="<%= p.ARTICLE || '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label">Description (nom court du produit)</label>
                <input type="text" name="DESCRIPTION" class="form-control form-control-sm" value="<%= p.DESCRIPTION || '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label">Usage (phrase courte)</label>
                <input type="text" name="USAGE" class="form-control form-control-sm" value="<%= p.USAGE || '' %>">
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>

      <div class="row g-2 align-items-end mb-2">
        <div class="col-md-4">
          <label class="form-label small text-muted">Représentant qui soumet <span class="text-muted">(« Soumis par »)</span></label>
          <select name="representant_id" class="form-select form-select-sm">
            <option value="">— Choisir un représentant —</option>
            <% (representants || []).forEach(function(r) { %>
            <option value="<%= r.id %>"><%= r.prenom %> <%= r.nom %> — <%= r.poste %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small text-muted">Ou autre nom (optionnel)</label>
          <input type="text" name="genere_par" class="form-control form-control-sm" placeholder="Si absent de la liste ci-contre">
        </div>
      </div>
      <div class="d-flex gap-3 mb-4">
        <button type="submit" class="btn btn-success btn-lg" id="btnGenerer">
          <i class="bi bi-file-earmark-zip"></i> Générer <%= produits.length %> bordereau<%= produits.length > 1 ? 'x' : '' %> + fiches techniques
        </button>
        <a href="/bordereaux" class="btn btn-outline-secondary btn-lg">Annuler</a>
      </div>
    </form>

    <% if (historique && historique.length > 0) { %>
    <div class="card mb-4">
      <div class="card-header bg-light py-2">
        <h6 class="mb-0"><i class="bi bi-clock-history"></i> Historique</h6>
      </div>
      <ul class="list-group list-group-flush">
        <% historique.forEach(function(h) { %>
        <li class="list-group-item small">
          <strong>
            <%= h.action === 'genere' ? 'Généré' : (h.action === 'approuve' ? 'Approuvé' : (h.action === 'modifications_demandees' ? 'Modifications demandées' : h.action)) %>
          </strong>
          <% if (h.effectue_par) { %> par <%= h.effectue_par %><% } %>
          <span class="text-muted">— <%= h.created_at %></span>
          <% if (h.commentaire) { %><div class="text-muted fst-italic mt-1"><%= h.commentaire %></div><% } %>
        </li>
        <% }); %>
      </ul>
    </div>
    <% } %>

  </div>
</div>

<script src="https://unpkg.com/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="/js/direct-upload.js"></script>
<script>
window.T3E_SUPABASE_URL = "<%= SUPABASE_URL %>";
window.T3E_SUPABASE_ANON_KEY = "<%= SUPABASE_ANON_KEY %>";

document.querySelectorAll('.btn-importer-ft').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var idx = btn.getAttribute('data-idx');
    var input = document.createElement('input');
    input.type = 'file';
    input.accept = '.pdf';
    input.addEventListener('change', function() {
      var file = input.files[0];
      if (!file) return;
      btn.disabled = true;
      var texteOriginal = btn.innerHTML;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Envoi…';
      t3eDirectUpload.uploadDirect(file, 'temp').then(function(info) {
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/bordereaux/importer-ft/<%= bordereau.id %>';
        [
          ['produit_index', idx],
          ['cle_temp', info.key],
          ['nom_fichier', info.name],
        ].forEach(function(pair) {
          var inp = document.createElement('input');
          inp.type = 'hidden'; inp.name = pair[0]; inp.value = pair[1];
          form.appendChild(inp);
        });
        document.body.appendChild(form);
        form.submit();
      }).catch(function(err) {
        alert('Erreur lors de l\'envoi : ' + err.message);
        btn.disabled = false;
        btn.innerHTML = texteOriginal;
      });
    });
    input.click();
  });
});

function renum() {
  document.querySelectorAll('.produit-card').forEach(function(card, i) {
    var h6 = card.querySelector('h6');
    var icon = '<i class="bi bi-box-seam"></i> Produit ' + (i + 1);
    var titre = card.querySelector('input[name="TITRE"]').value;
    if (titre) icon += '<span class="text-muted ms-2">— ' + titre + '</span>';
    h6.innerHTML = icon;
  });
  var n = document.querySelectorAll('.produit-card').length;
  var btn = document.getElementById('btnGenerer');
  btn.innerHTML = '<i class="bi bi-file-earmark-zip"></i> Générer ' + n + ' bordereau' + (n > 1 ? 'x' : '') + ' + fiches techniques';
}

document.getElementById('formGenerer').addEventListener('submit', function() {
  var btn = document.getElementById('btnGenerer');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Génération en cours…';
});

var formConfirmer = document.getElementById('formConfirmer');
if (formConfirmer) {
  formConfirmer.addEventListener('submit', function(e) {
    var reponse = e.submitter && e.submitter.value;
    var commentaire = document.getElementById('commentaireConfirmer');
    if (reponse === 'oui' && !commentaire.value.trim()) {
      e.preventDefault();
      commentaire.classList.add('is-invalid');
      commentaire.focus();
    }
  });
}
</script>

<%- include('partials/footer', { scripts: [] }) %>
