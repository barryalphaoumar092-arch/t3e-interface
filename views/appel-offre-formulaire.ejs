<%- include('partials/header', { title: 'Formulaire de soumission', page: 'appels-offres' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/appels-offres">Appels d'offres SEAO</a></li>
    <li class="breadcrumb-item"><a href="/appels-offres/<%= appel.id %>"><%= appel.numero_seao %></a></li>
    <li class="breadcrumb-item active">Formulaire</li>
  </ol>
</nav>

<h2><i class="bi bi-file-earmark-text"></i> Formulaire de soumission — <%= appel.titre %></h2>

<% if (erreur) { %>
<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= erreur %></div>
<% } %>

<div class="card mb-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <span class="badge bg-info text-dark"><%= formulaire.format || '?' %></span>
      Statut : <strong><%= formulaire.statut %></strong>
    </div>
    <div class="d-flex gap-2">
      <form method="POST" action="/appels-offres/<%= appel.id %>/formulaire/<%= formulaire.id %>/remplir">
        <button type="submit" class="btn btn-warning"><i class="bi bi-magic"></i> Pré-remplir avec l'IA</button>
      </form>
      <% if (formulaire.cle_storage_rempli) { %>
      <a href="/appels-offres/<%= appel.id %>/formulaire/<%= formulaire.id %>/telecharger" class="btn btn-success">
        <i class="bi bi-download"></i> Télécharger le formulaire pré-rempli
      </a>
      <% } %>
    </div>
  </div>
</div>

<% if (formulaire.cle_storage_rempli) { %>
<div class="row">
  <div class="col-md-6">
    <div class="card mb-3">
      <div class="card-header bg-success text-white"><i class="bi bi-check-circle"></i> Champs pré-remplis automatiquement (<%= champsDetectes.length %>)</div>
      <div class="card-body">
        <% if (champsDetectes.length === 0) { %>
        <p class="text-muted small mb-0">Aucun champ n'a pu être rempli automatiquement.</p>
        <% } else { %>
        <ul class="mb-0">
          <% champsDetectes.forEach(function(c) { %><li><%= c %></li><% }) %>
        </ul>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card mb-3">
      <div class="card-header bg-warning text-dark"><i class="bi bi-pencil-square"></i> À compléter manuellement (<%= champsNonPlaces.length %>)</div>
      <div class="card-body">
        <p class="text-muted small">Prix, exclusions, addendas acceptés, délais, cautionnement et déclarations légales ne sont <strong>jamais</strong> remplis automatiquement — à valider vous-même avant dépôt.</p>
        <% if (champsNonPlaces.length > 0) { %>
        <ul class="mb-0">
          <% champsNonPlaces.forEach(function(c) { %><li><%= c %></li><% }) %>
        </ul>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% } else { %>
<div class="alert alert-secondary">Cliquez sur "Pré-remplir avec l'IA" pour lancer le remplissage automatique à partir de la base de connaissances (NEQ, RBQ, assurances, certifications...).</div>
<% } %>

<%- include('partials/footer', { scripts: [] }) %>
