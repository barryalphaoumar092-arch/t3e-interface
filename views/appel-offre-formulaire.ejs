<%- include('partials/header', { title: 'Formulaire de soumission', page: 'appels-offres' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/appels-offres">Appels d'offres SEAO</a></li>
    <li class="breadcrumb-item"><a href="/appels-offres/<%= appel.id %>"><%= appel.numero_seao %></a></li>
    <li class="breadcrumb-item active">Formulaire</li>
  </ol>
</nav>

<h2><i class="bi bi-file-earmark-text"></i> Formulaire de soumission — <%= appel.titre %></h2>

<% if (erreur) { %>
<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= erreur %></div>
<% } %>

<div class="card mb-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <span class="badge bg-info text-dark"><%= formulaire.format || '?' %></span>
      Statut :
      <span class="badge <%= formulaire.statut === 'valide' ? 'bg-success' : (formulaire.statut === 'pre_rempli' ? 'bg-warning text-dark' : 'bg-secondary') %>">
        <%= formulaire.statut === 'valide' ? 'Validé' : (formulaire.statut === 'pre_rempli' ? 'Brouillon — à valider' : 'À remplir') %>
      </span>
    </div>
    <div class="d-flex gap-2">
      <% if ((formulaire.format || '').toLowerCase() !== 'docx') { %>
      <a href="/appels-offres/<%= appel.id %>/formulaire/<%= formulaire.id %>/editeur" class="btn btn-outline-primary">
        <i class="bi bi-cursor"></i> Positionner les champs manuellement
      </a>
      <% } %>
      <form method="POST" action="/appels-offres/<%= appel.id %>/formulaire/<%= formulaire.id %>/remplir">
        <button type="submit" class="btn btn-warning"><i class="bi bi-magic"></i> <%= formulaire.positions && formulaire.positions !== '{}' ? 'Générer avec les positions placées' : "Pré-remplir avec l'IA" %></button>
      </form>
      <form method="POST" action="/appels-offres/<%= appel.id %>/formulaire/<%= formulaire.id %>/remplir?recalculer=1" title="Force une nouvelle analyse IA de la base de connaissances (ignore le cache de 30 jours) — utile après avoir ajouté un document.">
        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-repeat"></i> Réanalyser la base de connaissances</button>
      </form>
      <% if (formulaire.cle_storage_rempli) { %>
      <a href="/appels-offres/<%= appel.id %>/formulaire/<%= formulaire.id %>/telecharger" class="btn btn-success">
        <i class="bi bi-download"></i> Télécharger le <%= formulaire.statut === 'valide' ? 'formulaire' : 'brouillon' %>
      </a>
      <% } %>
      <% if (formulaire.cle_storage_rempli && formulaire.statut !== 'valide') { %>
      <form method="POST" action="/appels-offres/<%= appel.id %>/formulaire/<%= formulaire.id %>/valider" onsubmit="return confirm('Confirmer que ce formulaire est prêt (tous les champs vérifiés) ?');">
        <button type="submit" class="btn btn-success" <%= champsNonPlaces.length > 0 ? 'disabled title="Des champs sont encore manquants"' : '' %>>
          <i class="bi bi-check2-circle"></i> Marquer comme validé
        </button>
      </form>
      <% } %>
    </div>
  </div>
</div>

<% if ((formulaire.format || '').toLowerCase() !== 'docx') { %>
<p class="text-muted small">
  <i class="bi bi-lightbulb"></i> Astuce : sur un vrai formulaire SEAO (souvent des lignes à blanc répétées sans champs de formulaire réels), le placement automatique par IA peut se tromper d'endroit si un libellé apparaît plusieurs fois. <a href="/appels-offres/<%= appel.id %>/formulaire/<%= formulaire.id %>/editeur">Positionner les champs manuellement</a> une fois est plus fiable.
</p>
<% } %>

<% if (formulaire.cle_storage_rempli) { %>
<% if (champsNonPlaces.length > 0) { %>
<div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> <strong>Brouillon</strong> — <%= champsNonPlaces.length %> champ(s) encore manquant(s) avant de pouvoir valider ce formulaire.</div>
<% } %>
<p class="text-muted small">Traçabilité par zone du formulaire — chaque champ détecté dans le document est classé dans sa zone d'origine. Prix, exclusions, addendas acceptés, délais, cautionnement et déclarations légales ne sont <strong>jamais</strong> remplis automatiquement — à valider vous-même avant dépôt.</p>

<% Object.keys(ZONES).forEach(function(zoneKey) { %>
  <% var champsZone = zonesAvecChamps[zoneKey]; %>
  <% if (champsZone && champsZone.length > 0) { %>
  <div class="card mb-3">
    <div class="card-header bg-light"><i class="bi bi-folder2"></i> <%= ZONES[zoneKey] %> <span class="badge bg-secondary ms-1"><%= champsZone.length %></span></div>
    <div class="table-responsive">
      <table class="table table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr><th>Champ détecté</th><th>Valeur proposée</th><th>Source</th><th>Statut</th></tr>
        </thead>
        <tbody>
          <% champsZone.forEach(function(c) { %>
          <tr>
            <td><%= c.nom %></td>
            <td><%= c.valeur || '—' %></td>
            <td class="text-muted small"><%= c.source %></td>
            <td>
              <% if (c.statut === 'manquant') { %>
                <span class="badge bg-danger">Manquant</span>
              <% } else { %>
                <span class="badge bg-warning text-dark">À valider</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
<% }) %>
<% } else { %>
<div class="alert alert-secondary">Cliquez sur "Pré-remplir avec l'IA" pour lancer le remplissage automatique à partir de la base de connaissances (NEQ, RBQ, assurances, certifications...).</div>
<% } %>

<%- include('partials/footer', { scripts: [] }) %>
