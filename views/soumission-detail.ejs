<%- include('partials/header', { title: 'Soumission ' + soumission.numero, page: 'soumissions' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/soumissions">Soumissions</a></li>
    <li class="breadcrumb-item active"><%= soumission.numero %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h2><i class="bi bi-file-earmark-ruled"></i> <%= soumission.numero %></h2>
    <p class="text-muted mb-0"><%= labelSysteme %> — <%= soumission.langue %></p>
  </div>
  <div>
    <% if (soumission.generation_statut !== 'en_cours' && soumission.fichier_genere) { %>
    <a href="/soumissions/<%= soumission.id %>/telecharger" class="btn btn-success"><i class="bi bi-download"></i> Télécharger le .docx</a>
    <% } %>
    <form method="POST" action="/soumissions/<%= soumission.id %>/supprimer" class="d-inline" onsubmit="return confirm('Supprimer cette soumission ?')">
      <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
    </form>
  </div>
</div>

<% if (soumission.generation_statut === 'en_cours') { %>
<div class="alert alert-info">
  <span class="spinner-border spinner-border-sm me-2"></span>
  Génération en cours (lecture des documents, analyse IA)… Cette page se recharge automatiquement.
</div>
<script>setTimeout(function() { location.reload(); }, 6000);</script>
<% } else if (soumission.generation_statut === 'erreur') { %>
<div class="alert alert-danger">
  <i class="bi bi-exclamation-octagon"></i> <strong>La génération a échoué</strong>
  <% if (soumission.generation_erreur) { %><div class="small mt-1"><%= soumission.generation_erreur %></div><% } %>
  <form method="POST" action="/soumissions/<%= soumission.id %>/relancer" class="mt-2">
    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-arrow-clockwise"></i> Réessayer</button>
  </form>
</div>
<% } %>

<% var aValider = rapport.filter(function(r) { return r.statut !== 'confirme'; }); %>
<% if (soumission.generation_statut !== 'en_cours' && aValider.length > 0) { %>
<div class="alert alert-warning">
  <i class="bi bi-exclamation-triangle"></i> <strong><%= aValider.length %> champ(s) à valider</strong> avant l'envoi — voir surlignés ci-dessous.
</div>
<% } %>

<% if (soumission.generation_statut !== 'en_cours' && documentsSources.length > 0) { %>
<div class="card card-body mb-3">
  <h6 class="mb-2"><i class="bi bi-paperclip"></i> Documents analysés</h6>
  <ul class="mb-0 small">
    <% documentsSources.forEach(function(d) { %>
    <li><%= d.nom_fichier %> <span class="badge bg-secondary"><%= d.categorie %></span></li>
    <% }) %>
  </ul>
  <% if (documentsVides.length > 0) { %>
  <p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle"></i> Aucun texte extractible (probablement des plans vectoriels/scannés) : <%= documentsVides.join(', ') %></p>
  <% } %>
</div>
<% } %>

<% if (soumission.generation_statut !== 'en_cours') { %>
<div class="table-responsive">
  <table class="table table-sm table-hover align-middle">
    <thead class="table-light">
      <tr><th>Champ</th><th>Valeur retenue</th><th>Statut</th><th>Source</th><th>Confiance</th></tr>
    </thead>
    <tbody>
      <% rapport.forEach(function(r) { %>
      <tr class="<%= r.statut !== 'confirme' ? 'table-warning' : '' %>">
        <td><code><%= r.champ %></code></td>
        <td><%= r.valeur %><% if (r.notes) { %><br><small class="text-muted"><%= r.notes %></small><% } %></td>
        <td><span class="badge bg-<%= r.statut === 'confirme' ? 'success' : (r.statut === 'contradictoire' ? 'danger' : 'warning text-dark') %>"><%= r.statut %></span></td>
        <td><small class="text-muted"><%= r.document_source %><% if (r.page_source) { %> (p. <%= r.page_source %>)<% } %></small></td>
        <td><small class="text-muted"><%= r.niveau_confiance %></small></td>
      </tr>
      <% }) %>
      <% if (rapport.length === 0) { %>
      <tr><td colspan="5" class="text-center text-muted py-4">Aucun rapport d'extraction disponible.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('partials/footer', { scripts: [] }) %>
