<%- include('partials/header', { title: 'Soumissions', page: 'soumissions' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><i class="bi bi-file-earmark-ruled"></i> Soumissions privées</h2>
  <a href="/soumissions/nouveau" class="btn btn-danger"><i class="bi bi-plus-circle"></i> Nouvelle soumission</a>
</div>

<div class="row mb-3">
  <div class="col-md-4">
    <div class="card card-body text-center"><h3><%= stats.total || 0 %></h3><p class="text-muted mb-0">Total</p></div>
  </div>
  <div class="col-md-4">
    <div class="card card-body text-center"><h3><%= stats.generes || 0 %></h3><p class="text-muted mb-0">Générées</p></div>
  </div>
  <div class="col-md-4">
    <div class="card card-body text-center"><h3><%= stats.envoyes || 0 %></h3><p class="text-muted mb-0">Envoyées</p></div>
  </div>
</div>

<form method="GET" class="row g-2 mb-3">
  <div class="col-md-6"><input type="text" name="q" class="form-control" placeholder="Client, projet, numéro..." value="<%= filtres.q %>"></div>
  <div class="col-md-4">
    <select name="statut" class="form-select">
      <option value="">Tous les statuts</option>
      <% ['genere','revise','approuve','envoye'].forEach(function(s) { %>
      <option value="<%= s %>" <%= filtres.statut === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-2"><button type="submit" class="btn btn-outline-secondary w-100">Filtrer</button></div>
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Numéro</th><th>Client</th><th>Système</th><th>Statut</th><th>Date</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% soumissions.forEach(function(s) { %>
      <tr>
        <td><span class="badge bg-secondary"><%= s.numero %></span></td>
        <td><%= s.client_nom || '-' %><% if (s.projet_nom) { %><br><small class="text-muted"><%= s.projet_nom %></small><% } %></td>
        <td><small><%= s.systeme_toiture %></small></td>
        <td><span class="badge bg-<%= s.statut === 'genere' ? 'success' : 'warning text-dark' %>"><%= s.statut %></span></td>
        <td><small class="text-muted"><%= s.created_at ? s.created_at.substring(0,10) : '-' %></small></td>
        <td>
          <a href="/soumissions/<%= s.id %>" class="btn btn-sm btn-outline-primary" title="Voir"><i class="bi bi-eye"></i></a>
          <% if (s.fichier_genere) { %>
          <a href="/soumissions/<%= s.id %>/telecharger" class="btn btn-sm btn-outline-success" title="Télécharger"><i class="bi bi-download"></i></a>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (soumissions.length === 0) { %>
      <tr><td colspan="6" class="text-center text-muted py-5">
        <i class="bi bi-inbox" style="font-size:3rem;display:block;margin-bottom:.5rem;"></i>
        Aucune soumission générée.<br>
        <a href="/soumissions/nouveau" class="btn btn-danger mt-3"><i class="bi bi-magic"></i> Créer votre première soumission</a>
      </td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer', { scripts: [] }) %>
