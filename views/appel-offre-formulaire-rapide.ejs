<%- include('partials/header', { title: 'Remplir un formulaire rapidement', page: 'appels-offres' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/appels-offres">Appels d'offres SEAO</a></li>
    <li class="breadcrumb-item active">Remplir un formulaire rapidement</li>
  </ol>
</nav>

<h2><i class="bi bi-lightning-charge"></i> Remplir un formulaire rapidement</h2>
<p class="text-muted small">
  Déposez directement un formulaire de soumission (PDF ou Word) pour le faire pré-remplir par l'IA à partir de la base de connaissances — sans avoir à créer ou choisir un appel d'offres au préalable.
</p>

<% if (erreur) { %>
<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= erreur %></div>
<% } %>

<div class="card" style="max-width:600px">
  <div class="card-body">
    <form id="formRapide">
      <div class="mb-3">
        <label class="form-label">Formulaire de soumission (PDF ou .docx)</label>
        <input type="file" id="fichierRapide" class="form-control" accept=".pdf,.docx,.doc" required>
      </div>
      <button type="submit" id="btnRapide" class="btn btn-primary"><i class="bi bi-upload"></i> Déposer et continuer</button>
    </form>
  </div>
</div>

<script src="https://unpkg.com/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="/js/direct-upload.js"></script>
<script>
window.T3E_SUPABASE_URL = "<%= SUPABASE_URL %>";
window.T3E_SUPABASE_ANON_KEY = "<%= SUPABASE_ANON_KEY %>";

document.getElementById('formRapide').addEventListener('submit', function (e) {
  e.preventDefault();
  var fichier = document.getElementById('fichierRapide').files[0];
  if (!fichier) return;
  var btn = document.getElementById('btnRapide');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Envoi...';

  t3eDirectUpload.uploadDirect(fichier, 'temp').then(function (info) {
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/appels-offres/rapide';
    [['fichier_key', info.key], ['fichier_name', info.name]].forEach(function (pair) {
      var inp = document.createElement('input');
      inp.type = 'hidden'; inp.name = pair[0]; inp.value = pair[1];
      form.appendChild(inp);
    });
    document.body.appendChild(form);
    form.submit();
  }).catch(function (err) {
    alert("Erreur lors de l'envoi du fichier : " + err.message);
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-upload"></i> Déposer et continuer';
  });
});
</script>

<%- include('partials/footer', { scripts: [] }) %>
