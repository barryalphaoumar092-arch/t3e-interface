<%- include('partials/header', { title: 'Nouvelle soumission', page: 'soumissions' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/soumissions">Soumissions</a></li>
    <li class="breadcrumb-item active">Nouvelle</li>
  </ol>
</nav>

<h2><i class="bi bi-magic"></i> Nouvelle soumission privée</h2>
<p class="text-muted small">
  Choisissez le système de toiture et déposez les documents du projet (appel d'offre, devis, plans, addendas — tous optionnels sauf au moins un document). Vous pouvez glisser plusieurs fichiers à la suite dans une même case, notamment pour les addendas : chaque ajout s'accumule, rien n'est remplacé. L'IA lit ces documents et remplit automatiquement le template Word correspondant — <strong>seules les informations réellement trouvées dans vos documents sont insérées</strong> ; tout le reste est marqué <span class="badge bg-warning text-dark">À VALIDER</span> plutôt que deviné.
</p>

<% if (!iaConfiguree) { %>
<div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> OPENAI_API_KEY n'est pas configurée — l'extraction automatique est indisponible.</div>
<% } %>
<% if (erreur) { %>
<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= erreur %></div>
<% } %>

<form method="POST" action="/soumissions/generer" id="formSoumission" class="card card-body" style="max-width:800px">
  <div class="row mb-3">
    <div class="col-md-8">
      <label class="form-label">Système de toiture</label>
      <select name="systeme" class="form-select" required>
        <option value="">-- Choisir --</option>
        <% systemes.forEach(function(s) { %>
        <option value="<%= s.cle %>"><%= s.label %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Langue</label>
      <select name="langue" class="form-select">
        <option value="FR">Français</option>
        <option value="EN">English</option>
      </select>
    </div>
  </div>

  <hr>
  <h6 class="mb-1">Documents du projet</h6>
  <p class="text-muted small mb-3">Chaque case accepte plusieurs fichiers, ajoutés un par un ou en groupe — les fichiers déjà déposés restent affichés en dessous ; cliquez sur un badge pour le retirer.</p>
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <label class="form-label small fw-bold">Appel d'offre du client</label>
      <input type="file" id="inputAppelOffre" class="form-control form-control-sm" accept=".pdf,.docx,.doc" multiple>
      <div class="mt-1" id="inputAppelOffreListe"></div>
    </div>
    <div class="col-md-6">
      <label class="form-label small fw-bold">Devis</label>
      <input type="file" id="inputDevis" class="form-control form-control-sm" accept=".pdf,.docx,.doc" multiple>
      <div class="mt-1" id="inputDevisListe"></div>
    </div>
    <div class="col-md-6">
      <label class="form-label small fw-bold">Plans</label>
      <input type="file" id="inputPlans" class="form-control form-control-sm" accept=".pdf" multiple>
      <div class="mt-1" id="inputPlansListe"></div>
    </div>
    <div class="col-md-6">
      <label class="form-label small fw-bold">Addendas</label>
      <input type="file" id="inputAddendas" class="form-control form-control-sm" accept=".pdf,.docx,.doc" multiple>
      <div class="mt-1" id="inputAddendasListe"></div>
    </div>
  </div>

  <button type="submit" class="btn btn-danger" id="btnGenerer"><i class="bi bi-magic"></i> Générer la soumission</button>
</form>

<script src="https://unpkg.com/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="/js/direct-upload.js"></script>
<script src="/js/accumulateur-fichiers.js"></script>
<script>
window.T3E_SUPABASE_URL = "<%= SUPABASE_URL %>";
window.T3E_SUPABASE_ANON_KEY = "<%= SUPABASE_ANON_KEY %>";

// Chaque case accumule les fichiers choisis au fil des selections successives
// (glisser un fichier puis un autre AJOUTE au lieu de remplacer) — voir
// accumulateur-fichiers.js, deja utilise par la page "Manuels".
var accumulateurs = {
  appel_offre: t3eAccumulateur.attacher(document.getElementById('inputAppelOffre'), document.getElementById('inputAppelOffreListe')),
  devis: t3eAccumulateur.attacher(document.getElementById('inputDevis'), document.getElementById('inputDevisListe')),
  plans: t3eAccumulateur.attacher(document.getElementById('inputPlans'), document.getElementById('inputPlansListe')),
  addendas: t3eAccumulateur.attacher(document.getElementById('inputAddendas'), document.getElementById('inputAddendasListe')),
};

document.getElementById('formSoumission').addEventListener('submit', function (e) {
  e.preventDefault();
  var form = e.target;
  var btn = document.getElementById('btnGenerer');
  var taches = [];
  var totalFichiers = 0;

  Object.keys(accumulateurs).forEach(function (categorie) {
    accumulateurs[categorie].getFiles().forEach(function (fichier) {
      totalFichiers++;
      taches.push(t3eDirectUpload.uploadDirect(fichier, 'temp').then(function (info) {
        var inpKey = document.createElement('input');
        inpKey.type = 'hidden'; inpKey.name = categorie + '_key'; inpKey.value = info.key;
        form.appendChild(inpKey);
        var inpNom = document.createElement('input');
        inpNom.type = 'hidden'; inpNom.name = categorie + '_name'; inpNom.value = info.name;
        form.appendChild(inpNom);
      }));
    });
  });

  if (totalFichiers === 0) { form.submit(); return; }

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Envoi et analyse en cours (peut prendre une minute)…';
  Promise.all(taches).then(function () {
    form.submit();
  }).catch(function (err) {
    alert("Erreur lors de l'envoi d'un document : " + err.message);
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-magic"></i> Générer la soumission';
  });
});
</script>

<%- include('partials/footer', { scripts: [] }) %>
